# PandaFM edge proxy: the single origin your phone talks to.
#
# Stage 1 serves plain HTTP on your LAN. Installing the PWA on Android
# needs HTTPS; that gets switched on in the PWA stage using Caddy's
# internal certificate authority.

:80 {
	encode zstd gzip

	# The API, including (from Stage 2) audio streams and cover art. The
	# browser never talks to Navidrome directly, so it never sees
	# Navidrome credentials and everything stays same-origin.
	handle /api/* {
		reverse_proxy pandafm-api:8000 {
			# Pass audio bytes through as they arrive instead of buffering.
			flush_interval -1
		}
	}

	# Everything else is the React app.
	handle {
		reverse_proxy pandafm-web:80
	}

	log {
		output stdout
		format console
	}
}
