<?xml version="1.0" encoding="utf-8"?>
<!-- Opt-in LAN build (-PpandafmAllowHttp=true): also allows plain http and
     certificate authorities the user installed (for a private home CA). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
