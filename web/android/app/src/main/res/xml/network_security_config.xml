<?xml version="1.0" encoding="utf-8"?>
<!-- Release default: HTTPS only, system certificate authorities only. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- The app's own bundled UI is served from https://localhost by Capacitor. -->
</network-security-config>
