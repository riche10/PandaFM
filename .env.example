# PandaFM Portainer stack environment variables
#
# In Portainer: Stacks > Add stack > Repository > Environment variables.
# You do NOT need to commit a .env file.

# UGREEN music library mounted on the Ubuntu host.
MUSIC_DIR=/mnt/ugreen/media/Music

# UID/GID used by Navidrome when reading the mounted music library.
PUID=1000
PGID=1000

# Navidrome
NAVIDROME_VERSION=0.64.2
NAVIDROME_PORT=4533
NAVIDROME_SCAN_SCHEDULE=@every 1h

# Create this account in Navidrome after first startup, then use the same
# credentials here so PandaFM can access the Subsonic API.
NAVIDROME_USER=
NAVIDROME_PASSWORD=

# PandaFM PostgreSQL database
POSTGRES_DB=pandafm
POSTGRES_USER=pandafm
POSTGRES_PASSWORD=

# PandaFM frontend entry point on the Ubuntu server.
# Example: http://SERVER-IP:8085
PANDAFM_HTTP_PORT=8085
PANDAFM_LOG_LEVEL=info
