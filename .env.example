# PandaFM settings (5.3). Copy to .env, or enter these in Portainer's
# environment variables. Only POSTGRES_PASSWORD is required.
#
# The music server (Navidrome or another OpenSubsonic server) is NOT
# configured here: open PandaFM after starting it and follow the setup.

# --- Required -------------------------------------------------------------
# Password for PandaFM's own PostgreSQL database (any long random string).
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# --- Optional -------------------------------------------------------------
# Port PandaFM's web app is published on.
# PANDAFM_WEB_PORT=8086

# Database name and user (defaults: pandafm).
# POSTGRES_DB=pandafm
# POSTGRES_USER=pandafm

# First-run owner setup. Without a token, the owner account can only be
# created from your home network (LAN or VPN). If PandaFM is reachable from
# the internet before you've set it up, set a long random token here and
# enter it in the setup screen.
# PANDAFM_SETUP_TOKEN=

# Reverse proxies whose X-Forwarded-For PandaFM trusts (comma-separated CIDRs).
# Default: private networks. See docs/security.md.
# PANDAFM_TRUSTED_PROXIES=

# PandaFM's installation key normally lives in the pandafm-config volume and
# is created automatically. Set this only if your orchestration supplies
# secrets itself (32 bytes, base64 or hex: `openssl rand -base64 32`).
# PANDAFM_CONFIG_KEY=

# Logging: debug, info, warning, error.
# PANDAFM_LOG_LEVEL=info

# Space for converted downloads and streaming copies (GB).
# PANDAFM_CACHE_MAX_GB=20

# Interactive API docs at /api/docs (owner-only when on).
# PANDAFM_API_DOCS=false

# Panda Mix: only playlists with Panda Mix enabled are analysed; PandaFM never scans the whole library.
# PANDAFM_MIX_ANALYSIS_WORKERS=1
# PANDAFM_MIX_LOOKAHEAD=3

# --- Upgrading from PandaFM 5.2 or earlier only ----------------------------
# If you used the old bundled Navidrome, PandaFM imports these once (and
# encrypts the password) when no music server is saved yet. Afterwards change
# the music server in Settings › Music server; these are then ignored.
# See docs/upgrading-to-5.3.md.
# PANDAFM_NAVIDROME_URL=http://navidrome.example.lan:4533
# PANDAFM_NAVIDROME_USER=
# PANDAFM_NAVIDROME_PASSWORD=

# Self-hosted Android updates (5.4.1): published releases, mounted read-only into the containers.
# PANDAFM_RELEASES_DIR=/srv/pandafm/releases

# 5.4.2: how long the server waits for Navidrome to start an audio stream (sleeping NAS disks).
# PANDAFM_NAVIDROME_STREAM_TIMEOUT_SECONDS=30
