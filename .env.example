# PandaFM configuration.
# Copy to .env (git-ignored) and fill in every empty value before the
# first `docker compose up`. Keep comments on their own lines.

# ── Host paths ───────────────────────────────────────────────────────

# Where your NAS music library is mounted ON THE UBUNTU HOST.
# Navidrome gets it read-only; PandaFM never touches these files.
MUSIC_DIR=/mnt/nas/music

# Navidrome's own database and caches. Create this folder yourself
# (mkdir -p) before the first start so it is owned by PUID:PGID.
NAVIDROME_DATA_DIR=./data/navidrome

# The user and group Navidrome runs as. Must be able to read MUSIC_DIR
# and write NAVIDROME_DATA_DIR. Find yours with: id -u ; id -g
PUID=1000
PGID=1000

# ── Navidrome ────────────────────────────────────────────────────────

NAVIDROME_VERSION=0.64.2
NAVIDROME_PORT=4533
NAVIDROME_SCAN_SCHEDULE="@every 1h"

# The Navidrome account PandaFM signs in with. Choose these now, then use
# exactly the same values when Navidrome asks you to create the first
# (admin) account. A separate non-admin account also works.
NAVIDROME_USER=
NAVIDROME_PASSWORD=

# ── Database ─────────────────────────────────────────────────────────

POSTGRES_DB=pandafm
POSTGRES_USER=pandafm
# Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=

# ── PandaFM ──────────────────────────────────────────────────────────

# Host port Caddy listens on. Change it if something already uses 80.
PANDAFM_HTTP_PORT=80
# debug, info, warning or error
PANDAFM_LOG_LEVEL=info
