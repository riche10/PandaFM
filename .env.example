# PandaFM Portainer stack environment variables
#
# Add these under Portainer > Stacks > PandaFM > Environment variables.
# Do not commit real credentials.

# UGREEN music library mounted on the Ubuntu Docker host.
MUSIC_DIR=/mnt/ugreen/media/Music

# UID/GID Navidrome uses to read the mounted library.
PUID=1000
PGID=1000

# Navidrome
NAVIDROME_VERSION=0.64.2
NAVIDROME_PORT=4533
NAVIDROME_SCAN_SCHEDULE=@every 1h
NAVIDROME_USER=
NAVIDROME_PASSWORD=

# PandaFM PostgreSQL
POSTGRES_DB=pandafm
POSTGRES_USER=pandafm
POSTGRES_PASSWORD=

# PandaFM's single published application port.
# Point your existing Nginx/Nginx Proxy Manager at this port.
PANDAFM_WEB_PORT=8085
PANDAFM_LOG_LEVEL=info

# Space the download conversion cache may use (converted copies are re-made on demand).
PANDAFM_CACHE_MAX_GB=20

# --- PandaFM 5.0 security -------------------------------------------------
# Needed once, to create PandaFM's owner account (first sign-in screen).
# Use a long random value, e.g. `openssl rand -hex 24`. Useless after setup.
PANDAFM_SETUP_TOKEN=
# Optional: the reverse proxies whose X-Forwarded-For you trust (JSON list).
# Default: private networks. Narrow it to your proxy, e.g. ["192.168.1.10/32", "172.16.0.0/12"].
# PANDAFM_TRUSTED_PROXIES=["192.168.1.10/32","172.16.0.0/12"]
# Interactive API docs at /api/docs (owner-only). Off by default.
PANDAFM_API_DOCS=false

# --- PandaFM 5.2 Panda Mix ---------------------------------------------------
# Songs are analysed only when a Panda Mix needs them (never the whole library).
# PANDAFM_MIX_ANALYSIS_WORKERS=1
# PANDAFM_MIX_LOOKAHEAD=3
# PANDAFM_MIX_ENABLED=true
