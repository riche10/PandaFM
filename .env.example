# PandaFM environment variables (a .env next to docker-compose.yml, or your Compose UI's variables).
# Never commit real values.

# Required
POSTGRES_PASSWORD=
# One-time token for creating the owner account in the browser (refused once an owner exists).
PANDAFM_SETUP_TOKEN=

# Optional
# PANDAFM_WEB_PORT=8086
# Encrypts the stored music-server password. Without it a key is generated once in the pandafm-data volume.
# PANDAFM_SECRET_KEY=
# PANDAFM_CACHE_MAX_GB=20
# PANDAFM_LOG_LEVEL=info
# PANDAFM_API_DOCS=false

# Panda Mix: songs are analysed only when a Panda Mix needs them (never the whole library).
# PANDAFM_MIX_ANALYSIS_WORKERS=1
# PANDAFM_MIX_LOOKAHEAD=3
# PANDAFM_MIX_ENABLED=true

# Legacy (5.2 and earlier). The music server is now connected in PandaFM's setup / Settings.
# While these are set they still manage it (copied into PandaFM, password encrypted).
# PANDAFM_NAVIDROME_URL=http://192.0.2.10:4533
# PANDAFM_NAVIDROME_USER=
# PANDAFM_NAVIDROME_PASSWORD=
